[Unit]
Description=Report MySQL backup status to Healthchecks (%i)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=yeogidot-backup
Group=yeogidot-backup
EnvironmentFile=/etc/yeogidot-backup/healthchecks.env
ExecStart=/usr/bin/python3 /usr/local/sbin/yeogidot-mysql-backup-notify %i
TimeoutStartSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StandardOutput=journal
StandardError=journal
