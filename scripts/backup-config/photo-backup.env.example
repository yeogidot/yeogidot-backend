# Outside Git: /etc/yeogidot-photo-backup/photo-backup.env, root:root 600.
# Source credential: read-only access to yeogidot-storage.
PHOTO_SOURCE_ENDPOINT_URL=https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com
PHOTO_SOURCE_BUCKET=yeogidot-storage
PHOTO_SOURCE_ACCESS_KEY_ID=REPLACE_SOURCE_READ_ONLY_KEY
PHOTO_SOURCE_SECRET_ACCESS_KEY=REPLACE_SOURCE_SECRET

# Destination credential: Object Read & Write, ONLY yeogidot-photo-backups.
# Source and backup can use the same account endpoint but MUST use separate scoped keys.
# Never make the backup bucket public or reuse the app/DB backup credential.
PHOTO_BACKUP_ENDPOINT_URL=https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com
PHOTO_BACKUP_REGION=auto
PHOTO_BACKUP_BUCKET=yeogidot-photo-backups
PHOTO_BACKUP_ACCESS_KEY_ID=REPLACE_BACKUP_BUCKET_KEY
PHOTO_BACKUP_SECRET_ACCESS_KEY=REPLACE_BACKUP_BUCKET_SECRET
PHOTO_RETENTION_DAYS=30
PHOTO_MAX_OBJECTS=10000
# Fail above 256 MiB of source data; review retention/cost before raising this limit.
# This does not measure total account usage or guarantee a free bill.
PHOTO_MAX_BYTES=268435456
