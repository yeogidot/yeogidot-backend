[Unit]
Description=Encrypt MySQL backups and verify private R2 copies
Wants=network-online.target
After=network-online.target mysql-backup.service

[Service]
Type=oneshot
User=yeogidot-backup
Group=yeogidot-backup
UMask=0077
EnvironmentFile=/etc/yeogidot-backup/r2.env
Environment=R2_RETENTION_DAYS=30
ExecStart=/usr/bin/python3 /usr/local/sbin/yeogidot-mysql-backup-r2 /var/backups/yeogidot-mysql /etc/yeogidot-backup/age-recipient.txt
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/yeogidot-mysql
StandardOutput=journal
StandardError=journal
