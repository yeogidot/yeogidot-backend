[Unit]
Description=Encrypt photos and verify a separate private R2 backup
Wants=network-online.target
After=network-online.target
OnSuccess=photo-backup-notify@success.service
OnFailure=photo-backup-notify@fail.service

[Service]
Type=oneshot
User=yeogidot-backup
Group=yeogidot-backup
UMask=0077
EnvironmentFile=/etc/yeogidot-photo-backup/photo-backup.env
Environment=AWS_EC2_METADATA_DISABLED=true
ExecStart=/opt/yeogidot-photo-backup/venv/bin/python3 /usr/local/sbin/yeogidot-photo-backup backup /var/backups/yeogidot-photos /etc/yeogidot-backup/age-recipient.txt
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/yeogidot-photos
StandardOutput=journal
StandardError=journal

