[Unit]
Description=Report photo backup status to its own Healthchecks check (%i)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=yeogidot-backup
Group=yeogidot-backup
EnvironmentFile=/etc/yeogidot-photo-backup/healthchecks.env
Environment=HEALTHCHECKS_KIND=photos
ExecStart=/usr/bin/python3 /usr/local/sbin/yeogidot-mysql-backup-notify %i
TimeoutStartSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StandardOutput=journal
StandardError=journal

