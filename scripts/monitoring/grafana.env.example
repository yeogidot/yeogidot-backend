# /etc/yeogidot-monitoring/grafana.env, root:root 600.
# EnvironmentFile is loaded by systemd. Grant metrics:write to this stack only.
GRAFANA_PROMETHEUS_URL=https://REPLACE_FROM_GRAFANA/api/prom/push
GRAFANA_PROMETHEUS_USER=REPLACE_WITH_METRICS_INSTANCE_ID
GRAFANA_METRICS_TOKEN=REPLACE_ON_SERVER_ONLY
